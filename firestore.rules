// Verdly Habits Firestore Security Rules
//
// Deploy: `firebase deploy --only firestore` (requires firebase.json in project root)
// Or paste into Firebase Console → Firestore Database → Rules → Publish.
// Without these rules, Connect / friend requests and challenge joins return PERMISSION_DENIED.
//
// Design summary:
//  - challenges/{id}: only members can list. Anyone signed in can `get` by id
//    (so deep links / pasted ids still work). Any signed-in user may update the
//    doc IF the only thing they are doing is adding themselves to `members`
//    (the join flow). Members may update their own progress fields. Only the
//    creator may end / archive the challenge.
//  - invites/{INVITECODE}: any signed-in user can `get` to resolve a code to a
//    challenge id. Only the creator may write the invite mapping (done in the
//    same batch as challenge creation).
//  - users/{uid}: each user reads / writes their own doc; others can read a
//    minimal public profile (username, photoUrl) for leaderboards.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // --- users ---
    match /users/{userId} {
      // Public read so other members can render names / avatars on leaderboards.
      // Progress fields (xp, level, totalCompletions, longestStreakEver, habitsJson,
      // achievementsJson, trophyFactsJson, createdAt) are owner-written and restored
      // on every sign-in so reinstall does not wipe a returning user's grove.
      // lastActiveAt and shareLastActive live here for grove list reads.
      // Display is client-gated: both users must have shareLastActive != false
      // (missing shareLastActive counts as on). Owner-only writes below.
      allow read: if signedIn();
      allow create, update: if signedIn() && uid() == userId;
      allow delete: if false;

      // In-app notification inbox (friend requests, duo invites, arena, activity).
      match /inbox/{itemId} {
        allow read, update, delete: if signedIn() && uid() == userId;
        allow create: if signedIn()
          && request.resource.data.actorUid == uid()
          && request.resource.data.type is string
          && request.resource.data.title is string
          && request.resource.data.body is string;
      }

      // Who opened this user's profile card. Owner reads the list; viewer writes their own row.
      match /profileViews/{viewerUid} {
        allow read: if signedIn() && uid() == userId;
        allow create, update: if signedIn()
          && uid() == viewerUid
          && request.resource.data.viewerUid == uid()
          && request.resource.data.weekKey is string;
        allow delete: if false;
      }

      // Dismissed dev announcements (Live Pulse / Activity).
      match /announcementReads/{announcementId} {
        allow read, write: if signedIn() && uid() == userId;
      }

      // Last-active heartbeat. Owner writes a tiny live doc; any signed-in user may
      // read it. Clients hide it unless BOTH people have shareLastActive != false.
      // lastActiveAt is also mirrored on the parent user doc for grove list reads.
      match /presence/{docId} {
        allow read: if signedIn() && docId == 'live';
        allow create, update: if signedIn()
          && uid() == userId
          && docId == 'live'
          && request.resource.data.keys().hasOnly(['lastActiveAt', 'shareLastActive'])
          && request.resource.data.shareLastActive is bool
          && (request.resource.data.lastActiveAt is timestamp
              || request.resource.data.lastActiveAt is int);
        allow delete: if signedIn() && uid() == userId && docId == 'live';
      }

      // Coin wallet — owner-only. Coins are recognition currency, never cash:
      // no rule here (or anywhere) permits transferring value out of the app.
      match /wallet/{document=**} {
        allow read, write: if signedIn() && uid() == userId;
      }

      // Personal blocks — hide another user from my social surfaces.
      // Doc id = blockedUid. Not a platform ban (those are Console-only).
                    match /blocked/{blockedUid} {
        allow read, write: if signedIn()
          && uid() == userId
          && blockedUid != uid();
      }

      // Friends Grove "Saw you" — one write per (day, fromUid). Not a comment thread.
      match /witnesses/{witnessId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.fromUid == uid()
          && request.resource.data.fromUid != userId
          && request.resource.data.day is string
          && witnessId == request.resource.data.day + '_' + uid();
        allow update, delete: if false;
      }

      // Cosmetic / coin gifts from friends. Receiver claims; sender cannot write the user doc.
      match /groveGifts/{giftId} {
        allow read: if signedIn() && (uid() == userId || resource.data.fromUid == uid());
        allow create: if signedIn()
          && request.resource.data.fromUid == uid()
          && request.resource.data.toUid == userId
          && request.resource.data.amount is int
          && request.resource.data.amount > 0;
        allow update: if signedIn() && uid() == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed']);
        allow delete: if false;
      }
    }

    // Dev broadcasts — read active promos/updates; writes via Console or Admin SDK only.
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // --- friendRequests: Connect / friends (doc id: {fromUid}_{toUid}) ---
    match /friendRequests/{requestId} {
      // GET on a missing doc must be allowed or Connect fails before first write
      // (resource is null when the doc does not exist yet).
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/friendRequests/$(requestId))
        || resource.data.fromUid == uid()
        || resource.data.toUid == uid()
      );

      allow list: if signedIn()
        && (resource.data.fromUid == uid() || resource.data.toUid == uid());

      allow create: if signedIn()
        && request.resource.data.fromUid == uid()
        && request.resource.data.toUid is string
        && request.resource.data.toUid != uid()
        && request.resource.data.status == 'pending';

      // Full-document writes from the app; either party may update if they are from/to.
      allow update: if signedIn()
        && (resource.data.fromUid == uid() || resource.data.toUid == uid())
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid;

      allow delete: if signedIn()
        && (resource.data.fromUid == uid() || resource.data.toUid == uid());
    }

    // --- challengeJoinRequests: "Ask to join" on a rival's arena ---
    match /challengeJoinRequests/{requestId} {
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/challengeJoinRequests/$(requestId))
        || resource.data.fromUid == uid()
        || resource.data.hostUid == uid()
        || resource.data.targetMemberUid == uid()
      );

      allow list: if signedIn()
        && (resource.data.fromUid == uid()
          || resource.data.hostUid == uid()
          || resource.data.targetMemberUid == uid());

      allow create: if signedIn()
        && request.resource.data.fromUid == uid()
        && request.resource.data.hostUid is string
        && request.resource.data.challengeId is string
        && request.resource.data.status == 'pending';

      allow update: if signedIn()
        && resource.data.hostUid == uid()
        && request.resource.data.status in ['approved', 'declined'];

      allow delete: if signedIn()
        && (resource.data.fromUid == uid() || resource.data.hostUid == uid());
    }

    // --- invites: public-by-code mapping ---
    match /invites/{code} {
      // Any signed-in user can resolve a known 6-letter code to its challenge id.
      // List is intentionally disabled — codes must be shared out-of-band.
      allow get: if signedIn();
      allow list: if false;

      // The creator writes the mapping in the same batch as the challenge.
      allow create: if signedIn()
        && request.resource.data.creatorId == uid()
        && request.resource.data.challengeId is string
        && request.resource.data.inviteCode == code;

      // Allow the original creator to mark an invite inactive (e.g. on end).
      allow update: if signedIn() && resource.data.creatorId == uid();
      allow delete: if signedIn() && resource.data.creatorId == uid();
    }

    // --- challenges ---
    match /challenges/{challengeId} {

      function isMember() {
        return signedIn() && uid() in resource.data.members;
      }

      function isCreator() {
        return signedIn() && resource.data.creatorId == uid();
      }

      function reactionPointsChanged() {
        return request.resource.data.memberReactionPoints != resource.data.memberReactionPoints;
      }

      // Denormalized points may only move as part of a reaction update. The app
      // enforces exact valid deltas transactionally; rules prevent standalone
      // arbitrary point writes.
      function validReactionPointWrite() {
        return !reactionPointsChanged()
          || request.resource.data.reactions != resource.data.reactions;
      }

      // Single-document reads are allowed for any signed-in user (needed for
      // join-by-code: the joiner must read the doc once before joining).
      allow get: if signedIn();

      // Listing the collection is restricted to "my challenges only" — clients
      // should always include whereArrayContains("members", uid).
      allow list: if signedIn() && uid() in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.creatorId == uid()
        && uid() in request.resource.data.members;

      // Joining: a non-member is allowed to update IFF the only effect is
      // adding themselves to members (and seeding their own per-user maps).
      function isSelfJoin() {
        return signedIn()
          && !(uid() in resource.data.members)
          && uid() in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() + 1
          // do not let a joiner flip core flags
          && request.resource.data.creatorId == resource.data.creatorId
          && request.resource.data.isActive == resource.data.isActive
          && request.resource.data.startDate == resource.data.startDate
          && request.resource.data.endDate == resource.data.endDate
          && request.resource.data.inviteCode == resource.data.inviteCode;
      }

      // Existing members may update progress (completions, streaks, etc.).
      // The creator may end/archive the challenge.
      allow update: if isSelfJoin() || ((isMember() || isCreator()) && validReactionPointWrite());

      allow delete: if isCreator();

      // --- coin gifts & consistency bonuses between members ---
      // senderId must be the caller; recipients receive recognition coins.
      // Reads also matched by the collection-group rule below for inbox queries.
      match /coinEvents/{eventId} {
        allow read: if signedIn()
          && uid() in get(/databases/$(database)/documents/challenges/$(challengeId)).data.members;
        allow create: if signedIn()
          && request.resource.data.senderId == uid()
          && uid() in get(/databases/$(database)/documents/challenges/$(challengeId)).data.members
          && request.resource.data.type in ['GIFT', 'CONSISTENCY_BONUS']
          && request.resource.data.amountEach is int
          && request.resource.data.amountEach > 0
          && request.resource.data.recipients is list;
        allow update, delete: if false;
      }

      // --- activity feed events written by markCompletion etc. ---
      match /activity/{eventId} {
        allow read: if signedIn() && uid() in get(/databases/$(database)/documents/challenges/$(challengeId)).data.members;
        allow create: if signedIn() && uid() in get(/databases/$(database)/documents/challenges/$(challengeId)).data.members;
        // Actor may replace or remove their own feed docs (check-in delete / re-post uses deterministic ids).
        allow update, delete: if signedIn()
          && resource.data.actorId == request.auth.uid
          && uid() in get(/databases/$(database)/documents/challenges/$(challengeId)).data.members;
      }
    }

    // Collection-group read for "gifts addressed to me" across challenges.
    match /{path=**}/coinEvents/{eventId} {
      allow read: if signedIn()
        && (uid() in resource.data.recipients || resource.data.senderId == uid());
    }

    match /notificationQueue/{queueId} {
      allow create: if signedIn()
        && request.resource.data.targetUid is string
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.challengeId is string;
      allow read, update, delete: if false;
    }

    // --- proof reports ---
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == uid()
        && request.resource.data.challengeId is string
        && request.resource.data.proofKey is string;
      allow read, update, delete: if false;
    }

    // --- user profile reports ---
    match /userReports/{reportId} {
      // Allow GET on missing docs so the client can check before create.
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/userReports/$(reportId))
        || resource.data.reporterUid == uid()
      );
      allow list: if signedIn() && resource.data.reporterUid == uid();

      allow create: if signedIn()
        && request.resource.data.reporterUid == uid()
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUsername is string
        && request.resource.data.reasonCode is string
        && request.resource.data.reasonLabel is string
        && request.resource.data.status == 'pending'
        && request.resource.data.reportedUid != uid()
        && reportId == request.resource.data.reporterUid + '_' + request.resource.data.reportedUid;

      allow update: if signedIn()
        && resource.data.reporterUid == uid()
        && request.resource.data.reporterUid == resource.data.reporterUid
        && request.resource.data.reportedUid == resource.data.reportedUid
        && request.resource.data.status == 'pending'
        && resource.data.status == 'pending'
        && reportId == resource.data.reporterUid + '_' + resource.data.reportedUid;

      allow delete: if false;
    }

    // --- referral codes (code -> owner mapping) ---
    match /referralCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.fullCode == code;
      allow update: if signedIn()
        && resource.data.ownerUid == uid()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.fullCode == resource.data.fullCode;
      allow delete: if false;
    }

    // --- duo streak / accountability pairs ---
    // Day-close fields (streakDays, lastBothCompleteDate, dayClosed, dayClosedAt,
    // milestonesAwarded) are Admin-SDK only via reportDuoDayProgress. Clients may
    // still write memberProgress for optimistic UI, but closing the day requires the CF.
    match /duoStreaks/{pairId} {
      allow get: if signedIn()
        && request.auth.uid in resource.data.members;
      allow list: if signedIn()
        && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && (
          (resource.data.status == 'pending'
            && request.resource.data.status == 'active'
            && request.resource.data.invitedBy == resource.data.invitedBy)
          || (resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberProgress', 'graceForgivenDate', 'graceWeekKey'])
            && request.resource.data.streakDays == resource.data.streakDays
            && request.resource.data.get('lastBothCompleteDate', null)
                 == resource.data.get('lastBothCompleteDate', null)
            && request.resource.data.get('dayClosed', null)
                 == resource.data.get('dayClosed', null))
        );
      allow delete: if signedIn()
        && request.auth.uid in resource.data.members;

      match /swaps/{swapId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/duoStreaks/$(pairId)).data.members;
        // Writes go through grantDuoSwap (Admin SDK) only.
        allow write: if false;
      }
    }

    // --- nudges: lightweight pokes between friends/duo buddies/rivals (doc id: {fromUid}_{toUid}) ---
    // A single doc per direction throttles repeat sends — the app checks lastSentAt
    // client-side before allowing another write, so this never stacks up requests.
    match /nudges/{pairId} {
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/nudges/$(pairId))
        || resource.data.fromUid == uid()
        || resource.data.toUid == uid()
      );
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.fromUid == uid()
        && request.resource.data.toUid is string
        && request.resource.data.toUid != uid()
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 160;

      allow update: if signedIn()
        && resource.data.fromUid == uid()
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 160;

      allow delete: if false;
    }

    // --- referral signups retention bonus flag ---
    match /referrals/{referrerUid}/signups/{refereeUid} {
      allow get: if signedIn()
        && (referrerUid == uid() || refereeUid == uid());
      allow list: if signedIn() && referrerUid == uid();
      allow create: if signedIn()
        && refereeUid == uid()
        && referrerUid != uid()
        && request.resource.data.refereeUid == uid()
        && request.resource.data.referrerUid == referrerUid
        && request.resource.data.code is string
        && request.resource.data.status == 'qualified';
      allow update: if signedIn() && referrerUid == uid()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['retentionBonusGranted'])
        && request.resource.data.retentionBonusGranted == true;
      allow delete: if false;
    }

    // Global weekly board — clients read only. Cloud Functions / Console write.
    match /openGrove/{weekKey} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /openGroveHistory/{userId}/weeks/{weekKey} {
      allow read: if signedIn() && uid() == userId;
      allow write: if false;
    }
  }
}
