// Verdly Habits Firebase Storage Security Rules
//
// Deploy: `firebase deploy --only storage`
// Profile avatars: profile_pictures/{uid}.jpg
//
// Public read so Coil can load download URLs without auth headers.
// Writes remain owner-only.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profile_pictures/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /proofs/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
